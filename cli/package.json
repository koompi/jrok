{
  "name": "jrok",
  "version": "2.1.0",
  "description": "Expose local services (ports, Docker, Kubernetes) to the internet via secure reverse proxy",
  "main": "dist/index.js",
  "bin": {
    "jrok": "./dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/index.js --minify",
    "build:dev": "bun build src/index.ts --outdir dist --target node",
    "bundle": "bun build src/index.ts --compile --outfile bin/jrok-standalone",
    "bundle:all": "npm run build && npx @yao-pkg/pkg dist/index.js --targets node18-linux-x64,node18-macos-x64,node18-win-x64 --output bin/jrok",
    "dev": "bun run src/index.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "pkg": {
    "targets": [
      "node18-linux-x64",
      "node18-macos-x64",
      "node18-win-x64"
    ],
    "outputPath": "bin"
  },
  "keywords": [
    "reverse-proxy",
    "tunnel",
    "ngrok",
    "localtunnel",
    "docker",
    "kubernetes",
    "port-forwarding",
    "cli"
  ],
  "author": "jrok",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/koompi/jrok.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/koompi/jrok/issues"
  },
  "homepage": "https://github.com/koompi/jrok#readme",
  "dependencies": {
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.11.0",
    "esbuild": "^0.27.2"
  }
}
