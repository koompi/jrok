{
  "name": "jrok",
  "version": "2.1.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "jrok": "./cli/bin/jrok"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "prepare": "esbuild cli/src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=cli/dist/index.js --minify"
  },
  "dependencies": {
    "mongodb": "^6.4.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "esbuild": "^0.27.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
