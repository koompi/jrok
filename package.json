{
  "name": "jrok",
  "version": "2.1.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "jrok": "./cli/bin/jrok"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "build:cli": "node -e \"require('esbuild').build({ entryPoints: ['cli/src/index.ts'], bundle: true, platform: 'node', target: 'node18', format: 'cjs', outfile: 'cli/dist/index.js', minify: true }).catch(() => process.exit(1))\"",
    "prepare": "npm run build:cli"
  },
  "dependencies": {
    "mongodb": "^6.4.0",
    "esbuild": "^0.27.2",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
