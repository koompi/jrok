# MongoDB Atlas Connection
# Get connection string from: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/reverse2vps?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/reverse2vps

# Base Configuration
BASE_DOMAIN=tunnel.example.com
API_KEY=your-super-secret-api-key-change-this

# Server Configuration
PORT=3000

# KOOMPI OAuth Configuration
# Get these from https://dash.koompi.org after creating a project
KOOMPI_CLIENT_ID=your_koompi_client_id
KOOMPI_CLIENT_SECRET=your_koompi_client_secret
KOOMPI_REDIRECT_URI=http://localhost:3000/auth/callback

# Dashboard URL (used when OAuth redirects to backend first)
DASHBOARD_URL=http://localhost:5173

# JWT Configuration (for SaaS auth)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production


# VPS Server Configuration (Multi-VPS setup)
# This can be a JSON string or environment variable per server
# Example VPS servers (as JSON, define in MongoDB directly or via API)
# VPS_SERVERS=[
#   {
#     "id": "vps1",
#     "name": "Primary VPS",
