# ============================================
# KPROXY ENVIRONMENT CONFIGURATION
# ============================================
# IMPORTANT: Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# REQUIRED IN PRODUCTION
# ============================================

# MongoDB Atlas Connection (REQUIRED)
# Get connection string from: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/kproxy?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/kproxy

# JWT Secret for authentication (REQUIRED - generate a secure random string)
# Generate with: openssl rand -base64 64
# In production, this MUST be set or the server will refuse to start
JWT_SECRET=

# Base domain for tunnel subdomains (REQUIRED)
BASE_DOMAIN=live.example.com

# ============================================
# Multi-node identity (for gossip routing + cross-node forwarding)
# ============================================
# Unique per node. Used as the gossip node id and for "lower id dials" peering.
VPS_ID=node-a
# Address other nodes use to reach this one DIRECTLY (not via Cloudflare) for
# the gossip mesh (/_gossip) and cross-node request forwarding.
VPS_HOST=127.0.0.1
# Shared secret guarding the gossip mesh — set the SAME value on every node.
# Without it, any host that can reach /_gossip can poison routing (hijack traffic).
GOSSIP_SECRET=

# MongoDB database name (defaults to "kproxy").
# MONGO_DB_NAME=kproxy

# ============================================
# Cloudflare for SaaS — custom domains (replaces Certbot/Let's Encrypt + nginx)
# ============================================
# Edge TLS is handled by Cloudflare. Our own subdomains use the zone's Universal
# SSL; customer custom domains are provisioned via Cloudflare for SaaS Custom
# Hostnames. Customers CNAME their domain (DNS only / grey cloud) to the fallback.
CF_API_TOKEN=          # token with "SSL and Certificates: Edit" on the zone
CF_ZONE_ID=            # zone that owns the fallback origin
CF_SAAS_FALLBACK_HOSTNAME=ssl.live.example.com  # hostname customers CNAME to (defaults to BASE_DOMAIN)

# ============================================
# KOOMPI OAuth (REQUIRED for dashboard login)
# ============================================
# Get these from https://dash.koompi.org after creating a project
KOOMPI_CLIENT_ID=
KOOMPI_CLIENT_SECRET=
KOOMPI_REDIRECT_URI=http://localhost:3000/auth/callback

# ============================================
# SERVER CONFIGURATION
# ============================================

# Server port
PORT=3000

# Environment mode (development | production)
NODE_ENV=development

# Dashboard URL (used for OAuth redirects)
DASHBOARD_URL=http://localhost:5173

# Allowed CORS origins (comma-separated)
# In production, set this to your actual dashboard URL(s)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# OPTIONAL — connection limits & TCP tunnel port range
# ============================================
# VPS_REGION=default
# TCP_PORT_MIN=10000
# TCP_PORT_MAX=20000
# MAX_AGENT_CONNECTIONS=5000
# MAX_CLIENT_CONNECTIONS=10000
# MAX_CONNECTIONS_PER_IP=100

# ============================================
# OPTIONAL — Telegram alerts
# ============================================
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Multi-node clusters scale horizontally: run this image on each node with a
# unique VPS_ID/VPS_HOST and the SAME GOSSIP_SECRET. Nodes discover each other
# and replicate the routing table over the gossip mesh — there is no nginx,
# no per-tunnel vhosts, and no SSH-based VPS provisioning.

