# ============================================
# JROK ENVIRONMENT CONFIGURATION
# ============================================
# IMPORTANT: Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# REQUIRED IN PRODUCTION
# ============================================

# MongoDB Atlas Connection (REQUIRED)
# Get connection string from: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/jrok?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/jrok

# JWT Secret for authentication (REQUIRED - generate a secure random string)
# Generate with: openssl rand -base64 64
# In production, this MUST be set or the server will refuse to start
JWT_SECRET=

# Base domain for tunnel subdomains (REQUIRED)
BASE_DOMAIN=tunnel.example.com

# ============================================
# KOOMPI OAuth (REQUIRED for dashboard login)
# ============================================
# Get these from https://dash.koompi.org after creating a project
KOOMPI_CLIENT_ID=
KOOMPI_CLIENT_SECRET=
KOOMPI_REDIRECT_URI=http://localhost:3000/auth/callback

# ============================================
# SERVER CONFIGURATION
# ============================================

# Server port
PORT=3000

# Environment mode (development | production)
NODE_ENV=development

# Dashboard URL (used for OAuth redirects)
DASHBOARD_URL=http://localhost:5173

# Allowed CORS origins (comma-separated)
# In production, set this to your actual dashboard URL(s)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# SECURITY & LOGGING
# ============================================

# Enable connection logging to MongoDB (default: disabled)
# WARNING: This will store every HTTP/TCP connection in MongoDB and can bloat your database
# Only enable if you need connection logs for debugging or security auditing
# Set to 'true' to enable, leave unset or 'false' to disable
# ENABLE_CONNECTION_LOGS=true


# VPS Server Configuration (Multi-VPS setup)
# This can be a JSON string or environment variable per server
# Example VPS servers (as JSON, define in MongoDB directly or via API)
# VPS_SERVERS=[
#   {
#     "id": "vps1",
#     "name": "Primary VPS",
#     "host": "vps1.example.com",
#     "sshUser": "root",
#     "sshPort": 22,
#     "nginxPath": "/etc/nginx/sites-available",
#     "region": "us-east"
#   },
#   {
#     "id": "vps2",
#     "name": "Secondary VPS",
#     "host": "vps2.example.com",
#     "sshUser": "root",
#     "sshPort": 22,
#     "nginxPath": "/etc/nginx/sites-available",
#     "region": "eu-west"
#   }
# ]


# ============ Proxy Mode ============
# Jrok runs as a pure proxy by default: no plan limits, no rate limits, no
# bandwidth quotas, and no plan lookups on the request path. Usage is still
# metered (in-memory counters, flushed to MongoDB every 30s) so kconsole can
# bill from it — kconsole owns quotas and pricing.
#
# Set to false to restore jrok's own plan enforcement (standalone/self-hosted).
JROK_PROXY_MODE=true

# Shared secret kconsole uses to push suspensions machine-to-machine:
#   POST   /security/suspensions  {"organizationId": "...", "reason": "..."}
#   DELETE /security/suspensions  {"organizationId": "..."}
#   GET    /security/suspensions
# Sent as the X-Admin-Key header. Falls back to API_KEY when unset.
# Suspensions are in-memory: re-push them from kconsole after a jrok restart.
JROK_ADMIN_KEY=change-this-admin-key

# ============ Request Routing & Client IPs ============
# Management API hosts. jrok decides from the Host header FIRST whether a
# request is for a customer's tunnel (<name>.<BASE_DOMAIN>, or an active custom
# domain) or for jrok's own API. Tunnel hosts never reach the API routes.
# The base domain apexes (BASE_DOMAIN, LEGACY_BASE_DOMAINS), localhost and IP
# literals are always API hosts. List extra ones here only if they would
# otherwise look like a tunnel subdomain (comma-separated hosts or URLs):
# JROK_API_HOSTS=api.tunnel.example.com
#
# Hosts that are neither a tunnel nor listed above still get the API, as before.
# Set to true to answer 404 there instead (agents' --server host must then be
# one of the API hosts too).
# JROK_STRICT_API_HOSTS=false

# Number of reverse proxies in front of jrok whose X-Forwarded-For entries are
# believed. The client is the entry that many places from the RIGHT (what the
# outermost trusted proxy appended). 1 = one nginx (the shipped setup);
# 2 = e.g. Cloudflare -> nginx -> jrok; 0 = jrok directly on the internet.
# TRUSTED_PROXY_HOPS=1
#
# Optional: socket addresses allowed to send forwarding headers (nginx, and the
# other jrok servers, which forward cross-server traffic). Exact IPs or IPv4
# CIDRs. A connection from anywhere else is identified by its socket address.
# Strongly recommended if jrok's port is reachable without going through nginx.
# TRUSTED_PROXY_IPS=127.0.0.1,::1,10.0.0.0/8

# ============ Platform Keys (kconsole) ============
# Keys that may (a) connect agents on behalf of another organization — only ever
# for custom domains — and (b) see and manage every org's domains, tunnel IP
# security, logs and agents (everyone else is limited to their own orgs; the
# server API_KEY and super-admins are always privileged). Pin it to kconsole's
# key id(s) — include BOTH the deploy worker's JROK_AUTH key and the backend's
# JROK_API_KEY if they differ. When unset, any key of the orgs below (or a key
# holding '*'/'sudo') qualifies.
# JROK_IMPERSONATION_KEY_IDS=
# Defaults to KOOMPI Cloud's org on the managed service; "none" disables.
# JROK_IMPERSONATION_ORG_IDS=af9ef06c-d009-4ed4-8d13-017622ac2014
