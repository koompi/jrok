# API URL - Backend server
# For development with proxy (default): leave empty or use /api
# For production or direct connection: use full URL like https://tunnel.matrixchat.space
VITE_API_URL=

# Example configurations:
# Local development (uses Vite proxy to localhost:3000):
# VITE_API_URL=/api

# Direct connection to local backend:
# VITE_API_URL=http://localhost:3000

# Production:
# VITE_API_URL=https://tunnel.matrixchat.space
